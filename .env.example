# Copy to .env. Anything set here (or as an environment variable) overrides the Settings screen.

PORT=8787
HOST=127.0.0.1
# Public HTTPS address if you deploy or tunnel (needed for Claude.ai / ChatGPT connectors and OAuth redirects)
# PUBLIC_URL=https://ap.example.com
# Required if the app is reachable from other machines
# APP_PASSWORD=

# demo | qbo | xero
LEDGER=demo

# anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# QuickBooks Online (developer.intuit.com)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# QBO_DEFAULT_TAX_CODE=

# Xero (developer.xero.com/app/manage)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# AUTHORISED (awaiting payment) or DRAFT
XERO_BILL_STATUS=AUTHORISED

# Controls
PO_TOLERANCE_PCT=2
# Let connected AI apps post bills without a person approving in the web app
ALLOW_AI_POSTING=false
